# Antares Code: the agent loop. The model answers, calls tools, sees what they
# gave back, and carries on until it has finished the task.

# Project notes, read at the start of every session: the first that exists.
# (NVCODE.md is this program's old name for them.)
MEMORY_FILES = ["ANTARES.md", "NVCODE.md", "AGENTS.md", "CLAUDE.md"]

# Where notes are written: the project's notes file, or a new ANTARES.md.
to notes_file() {
    m = project_memory()
    when m != nothing { give WORKDIR + "/" + m.name }
    give WORKDIR + "/ANTARES.md"
}

# Adds a line to the project's notes.
to add_note(note) {
    p = notes_file()
    snapshot(p)
    when not exists(p) { write(p, "# Notes for Antares Code\n\nRead at the start of every session.\n\n") }
    old = read(p)
    when old != "" and not ends(old, "\n") { append(p, "\n") }
    append(p, "- " + trim(replace(note, "\n", " ")) + "\n")
    refresh_system_prompt()
    give rel(p)
}

to tool_remember(a) {
    note = text(a.note)
    about = lower(text(arg(a, "about", "project")))
    tool_header("Remember", one_line(note, 90))
    when about == "you" or about == "user" {
        when add_user_note(note) {
            result_line(green("Saved about you") + dim(" (for every project)"))
            give "Saved; it will be known in every project from now on."
        }
        result_line(dim("already known"))
        give "That was already known."
    }
    ok = permitted("edit", "edit", "edit files")
    when not ok.ok { give refused(ok) }
    where = add_note(note)
    result_line(green("Saved in {where}"))
    give "Saved in {where}; it will be read at the start of every session."
}

to project_memory() {
    each name in MEMORY_FILES {
        p = WORKDIR + "/" + name
        when exists(p) { give {name: name, body: squeeze(read(p), 8000)} }
    }
    give nothing
}

# Whether the project is written in Antares: .ant files in the working
# folder or the folders just inside it.
to uses_antares() {
    try {
        each n in files(WORKDIR) {
            when ends(lower(n), ".ant") { give yes }
        }
        each n in files(WORKDIR) {
            sub = WORKDIR + "/" + n
            when not begins(n, ".") and is_folder(sub) {
                each m in files(sub) {
                    when ends(lower(m), ".ant") { give yes }
                }
            }
        }
    } else problem {
        give no
    }
    give no
}

# The guide is part of the program (lib/guide.ant, made from
# lib/antares_guide.md by build.ant), so acode.exe needs no other files.
# Next to the program, the .md is read instead, so edits to it count at once.
to antares_guide() {
    p = HOME + "/lib/antares_guide.md"
    when exists(p) { give read(p) }
    give GUIDE
}

# How independently the model works: on its own in yolo mode, checking in
# with the user otherwise.
to working_style() {
    when SETTINGS.mode == "yolo" {
        give "- Work autonomously, from start to finish. Nobody approves your tool calls and the user isn't watching each step, so don't stop to ask for permission or confirmation, and don't ask questions you can answer by looking at the code or trying things.
- When details are left open, make sensible, conventional choices and carry on; list the assumptions you made in your final answer.
- Keep going until the task is completely done and checked: when a test, build or run fails, find out why, fix it and run it again. Don't end your turn with work half done, or with a plan instead of the work.
- Stop and ask only when the request is so unclear that guessing would likely waste a lot of work, or when the next step would destroy data or reach outside the project (deleting files the user didn't mention, force pushes, installing software system-wide)."
    }
    give "- The user may refuse a tool call. Then don't repeat it: ask what they would like instead, or find another way.
- If something is unclear and you can't find out from the code, ask the user a short question instead of guessing."
}

# Brings the instructions up to date (after the mode changes, say).
to refresh_system_prompt() {
    when len(MESSAGES) > 0 and MESSAGES[0].role == "system" {
        msgs = MESSAGES
        msgs[0] = {role: "system", content: system_prompt()}
        change MESSAGES = msgs
    }
}

to system_prompt() {
    d = now()
    shell_name = "sh"
    when WINDOWS { shell_name = "cmd.exe on Windows (use Windows commands, such as dir, type and copy, or PowerShell through: powershell -Command ...)" }
    git_note = "no"
    when IN_GIT { git_note = "yes" }
    p = "You are {APP_NAME}, an expert software engineer working as a coding agent in the user's terminal. You help with programming tasks: writing code, fixing bugs, explaining code, refactoring, running tests and builds, and using git.

Environment:
- Working folder: {WORKDIR}
- Shell for run_command: {shell_name}
- Git repository: {git_note}
- Today: {d.year}-{pad(d.month, 2, "right", "0")}-{pad(d.day, 2, "right", "0")}

How to work:
- Look before you change anything: use list_files, find_files, search and read_file to understand the code and its conventions first. Never guess at a file's contents.
- Change existing files with edit_file, copying old_string exactly from what read_file showed (without the line numbers). Use write_file only for new files or complete rewrites.
- Match the style, libraries and patterns the project already uses. Don't add comments that only repeat the code.
- After changing code, check your work: run the tests, the build, or the program with run_command, and fix what fails.
- For a task with several steps, keep a task list with todo_write, and update it as you finish each step.
- Several changes to one file: multi_edit, in one go. Rename or move files with move_file, and delete with delete_file (only files you made, or that the user asked to delete).
- For documentation, error messages, library versions or anything you may not know well: web_search, then fetch_url to read a page.
- To explore a large codebase or answer a question that takes many searches, hand it to a helper with task; it reports back, and your conversation stays short.
- A server, watcher or game that keeps running: start it with start_process, check it with process_output (and fetch_url or run_command against it), and stop it with stop_process when finished.
- Memory: when the user asks you to remember something, or you learn something lasting about them (their name, skills, the languages, tools or style they prefer), save it with remember (about: you for the user, project for this project). One short line each; never secrets.
- Never run destructive commands (deleting files or folders, git reset --hard, force pushes) unless the user asked for exactly that. Don't commit or push unless asked.
- A program that keeps running (a server, a game window, a watcher) never finishes by itself: run it with a short timeout (5 to 10 seconds) just to check that it starts without errors.
{working_style()}

How to answer:
- Be brief and direct. Use Markdown sparingly: short paragraphs, bullet points, and code blocks for code.
- When you have finished, say in a sentence or two what you changed and how you checked it. Mention any file by its path, as path:line where useful.
- Don't repeat large pieces of code that you have already written to files."
    when uses_antares() {
        p += "\n\nThis project is written in Antares (.ant files). Unless the user asks for another language, write new programs in Antares too, following the guide below, and run them with: antares file.ant\n\n" + antares_guide()
    }
    memory = project_memory()
    when memory != nothing {
        p += "\n\nProject notes, from {memory.name} in the working folder (follow them):\n" + memory.body
    }
    you = user_memory()
    when you != "" {
        p += "\n\nWhat you know about the user from earlier sessions (use it quietly; don't repeat it back):\n" + you
    }
    others = other_projects()
    when others != "" {
        p += "\n\nThe user's other projects, from earlier sessions (folder · date · what was done):\n" + others
    }
    give p
}

to start_conversation() {
    change MESSAGES = [{role: "system", content: system_prompt()}]
    change TODOS = []
}

# A rough count of the tokens in the conversation (about 4 characters each).
to conversation_tokens() = floor(len(to_json(MESSAGES)) / 4)

# Replaces the conversation with a summary of it, to make room.
to compact(note) {
    show dim("  ✻ Summarising the conversation to make room…")
    change SPIN_LABEL = "Summarising"
    asked = push(MESSAGES, {role: "user", content: "Summarise our conversation so far so that you can carry on the work from the summary alone. Include: what the user asked for, decisions made, files read or changed (with paths), commands run and their results, problems found, the current state, and what is left to do. " + note})
    try {
        r = nv_chat(asked, no)
        change SPIN_LABEL = "Thinking"
        summary = arg(r.choices[0].message, "content", "")
        when trim(summary) == "" { fail("the model gave an empty summary") }
        change MESSAGES = [
            {role: "system", content: system_prompt()},
            {role: "user", content: "This is a summary of our conversation so far:\n\n" + summary},
            {role: "assistant", content: "Thanks, I have the context and will carry on from here."},
        ]
        erase_line()
        show dim("  ✻ Conversation summarised: now about {conversation_tokens()} tokens")
        give yes
    } else problem {
        change SPIN_LABEL = "Thinking"
        show red("  Couldn't summarise: " + explain_problem(problem))
        give no
    }
}

to session_path() {
    name = lower(WORKDIR)
    each ch in [":", "/", "\\", " ", "."] { name = replace(name, ch, "_") }
    give DATA_DIR + "/sessions/" + name + ".json"
}

to save_session() {
    try {
        make_folder(DATA_DIR + "/sessions")
        save({workdir: WORKDIR, model_id: SETTINGS.model_id, messages: MESSAGES, todos: TODOS}, session_path())
    } else problem {
        # a session that can't be saved shouldn't stop the work
        nothing
    }
}

# The tool calls in a reply, made safe to read.
to calls_of(msg) {
    when not has(msg, "tool_calls") or msg.tool_calls == nothing { give [] }
    give msg.tool_calls
}

# The inputs of a tool call, as a map, or nothing if they can't be read.
# Models get JSON wrong in ways that differ from one model to the next (and
# with backups, one task can see several), so the text is repaired first;
# see repair_json.
to inputs_of(call) {
    raw = arg(call.function, "arguments", "")
    when kind(raw) == "map" { give raw }
    when kind(raw) != "text" or trim(raw) == "" { give {} }
    fixed_text = repair_json(raw)
    when fixed_text == nothing { fixed_text = raw }
    try {
        parsed = json(fixed_text)
        when kind(parsed) == "map" { give parsed }
        give {}
    } else problem {
        give nothing
    }
}

HEX_DIGITS = "0123456789abcdef"

# The number written in hexadecimal ("00e9" gives 233), or nothing.
to hex_value(t) {
    n = 0
    each c in lower(t) {
        d = find(HEX_DIGITS, c)
        when d < 0 { give nothing }
        n = n * 16 + d
    }
    give n
}

# A character as it may stand inside a JSON string read by Antares: quotes,
# backslashes and control characters escaped, the rest as it is.
to json_char(n) {
    when n == 34 { give "\\\"" }
    when n == 92 { give "\\\\" }
    when n == 10 { give "\\n" }
    when n == 9 { give "\\t" }
    when n == 13 { give "\\r" }
    when n < 32 { give " " }
    give char(n)
}

# Tool-call JSON as models really send it, made into JSON that Antares reads
# correctly, or nothing if it is cut off (a reply that hit the length limit:
# better dropped than half a file written). It
#   - takes away ```json fences, and words before or after the object;
#   - reads 'single-quoted' strings, and True, False and None;
#   - writes \uXXXX escapes as the characters they stand for (Antares's
#     json() doesn't read them: \u00e9 would come out as "u00e9");
#   - keeps the backslash of an escape JSON doesn't have ("C:\Users" would
#     otherwise come out as "C:Users");
#   - escapes raw control characters inside strings.
# Valid JSON comes out meaning the same.
to repair_json(raw) {
    t = trim(raw)
    when begins(t, "```") {
        nl = find(t, "\n")
        when nl < 0 { give nothing }
        t = trim(slice(t, nl + 1))
        when ends(t, "```") { t = trim(slice(t, 0, len(t) - 3)) }
    }
    start = find(t, "\{")
    when start < 0 { give nothing }
    when start > 0 { t = slice(t, start) }
    bs = char(92)
    out = ""
    depth = 0
    quote = ""            # the quote that opened the string we are in, or ""
    escaping = no         # just after a backslash, in a string
    hex = nothing         # the hex digits of a \u escape so far, or nothing
    high = nothing        # the first half of a surrogate pair, waiting
    word = ""             # a bare word outside strings (true, None, ...)
    done = no
    each c in t {
        when done {
            skip
        }
        when quote == "" {
            # outside strings
            when has("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", c) {
                word += c
                skip
            }
            when word != "" {
                when word == "True" { word = "true" } else when word == "False" { word = "false" } else when word == "None" { word = "null" }
                out += word
                word = ""
            }
            when c == "\"" or c == "'" {
                quote = c
                out += "\""
            } else when c == "\{" or c == "[" {
                depth += 1
                out += c
            } else when c == "}" or c == "]" {
                depth -= 1
                out += c
                when depth == 0 { done = yes }
            } else {
                out += c
            }
            skip
        }
        # inside a string
        when hex != nothing {
            hex += c
            when len(hex) < 4 { skip }
            n = hex_value(hex)
            when n == nothing {
                # not an escape after all: keep it as it was written
                out += bs + bs + "u" + hex
            } else when n >= 55296 and n <= 56319 {
                high = n
            } else when n >= 56320 and n <= 57343 and high != nothing {
                out += json_char(65536 + (high - 55296) * 1024 + (n - 56320))
                high = nothing
            } else {
                out += json_char(n)
            }
            hex = nothing
            skip
        }
        when escaping {
            escaping = no
            when c == "u" {
                hex = ""
            } else when c == "'" and quote == "'" {
                out += "'"
            } else when has("\"\\/bfnrt", c) {
                out += bs + c
            } else {
                out += bs + bs + c
            }
            skip
        }
        when c == bs {
            escaping = yes
        } else when c == quote {
            quote = ""
            out += "\""
        } else when c == "\"" {
            # a double quote inside a 'single-quoted' string
            out += bs + "\""
        } else {
            k = code(c)
            when k < 32 { out += json_char(k) } else { out += c }
        }
    }
    when not done or quote != "" { give nothing }
    give out
}

# ---------- the check before finishing ----------
# Free models often stop too soon: they change code and finish without
# running it, finish right after a step failed, or end with "Now I'll run
# the tests" and no tool call. When a request ends like that, the model is
# sent back once, with what is missing; it can carry on, or say in a line
# why not. Purely conversational answers aren't checked.

CHANGE_TOOLS = ["edit_file", "multi_edit", "write_file", "append_file"]
RUN_TOOLS = ["run_command", "start_process"]
# changes to these don't need running
NOT_CODE = [".md", ".txt", ".rst", ".csv", ".log"]
FINISH_NOTE = "[Antares Code, before you finish] "

to new_gate() = {checked: no, unchecked: [], failed: "", declined: no}

to is_code_file(p) {
    low = lower(text(p))
    each e in NOT_CODE {
        when ends(low, e) { give no }
    }
    give yes
}

# The exit code at the end of a command's result ("[exit code 2]"), or nothing.
to exit_code_in(result) {
    at = find(result, "[exit code ")
    when at < 0 { give nothing }
    rest = slice(result, at + 11)
    close = find(rest, "]")
    when close < 0 { give nothing }
    give number_or_nothing(slice(rest, 0, close))
}

# What a tool call tells the check: files changed and not run since, a step
# that failed, or the user turning a step down (then nothing is checked).
to track_step(g, name, a, result) {
    when begins(result, "The user") or begins(result, "This needs the user's") {
        g.declined = yes
        give g
    }
    when begins(result, "Not run") or has(READ_ONLY, name) { give g }
    code_seen = nothing
    when has(RUN_TOOLS, name) { code_seen = exit_code_in(result) }
    when begins(result, "Error") {
        g.failed = name + ": " + one_line(slice(result, 6), 100)
        give g
    }
    when code_seen != nothing and code_seen != 0 {
        g.failed = "`" + one_line(text(arg(a, "command", name)), 80) + "` exited with code {code_seen}"
        g.unchecked = []
        give g
    }
    g.failed = ""
    when has(CHANGE_TOOLS, name) {
        p = text(arg(a, "path", ""))
        when is_code_file(p) and not has(g.unchecked, p) { g.unchecked = push(g.unchecked, p) }
    } else when has(RUN_TOOLS, name) {
        g.unchecked = []
    }
    give g
}

# Whether a reply ends by promising more work instead of doing it.
to promises_more(content) {
    when kind(content) != "text" { give no }
    t = lower(trim(content))
    when ends(t, "?") { give no }
    when len(t) > 160 { t = slice(t, len(t) - 160) }
    each p in ["i'll now", "i will now", "now i'll", "now i will", "next, i'll", "next i'll", "now let me", "let me now", "i'm going to", "i am going to", "let's now", "now let's"] {
        when has(t, p) { give yes }
    }
    when has(t, "let me ") and not has(t, "let me know") { give yes }
    give no
}

# What is missing before the model may finish: [{short, long}], or [] (also
# when it was already sent back once in this request).
to finish_check(g, content) {
    when g.checked or g.declined or PLANNING { give [] }
    out = []
    when g.failed != "" {
        out = push(out, {short: "the last step failed", long: "the last step failed ({g.failed}) and nothing after it fixed that"})
    } else when len(g.unchecked) > 0 {
        shown = join(map(slice(g.unchecked, 0, min(3, len(g.unchecked))), p => rel(full_path(p))), ", ")
        when len(g.unchecked) > 3 { shown += " and {len(g.unchecked) - 3} more" }
        out = push(out, {short: "{shown} changed, not run since", long: "you changed {shown} but haven't run anything since to check it (the tests, the build or the program)"})
    }
    when promises_more(content) { out = push(out, {short: "it said it would do more", long: "your reply says you'll do more, but you didn't call a tool"}) }
    give out
}

to finish_prompt(reasons) = FINISH_NOTE + "Not quite done: " + join(map(reasons, r => r.long), "; ") + ". If there is more to do, carry on now with your tools. If not (nothing can be run, or it isn't needed), say why in one line and finish. (This check comes once per request.)"

# One turn: the user's message, then as many model replies and tool calls
# as it takes. Gives yes if it finished normally.
# How many times x is in a list.
to times_in(xs, x) = len(filter(xs, y => y == x))

# Said when the work is stopped part-way, by Esc or by the loop guard.
to stopped_note(steps, before) {
    when steps == 1 {
        change MESSAGES = slice(MESSAGES, 0, before)
        show dim("  Your message wasn't kept: send it again, or something else.")
    } else {
        save_session()
        show dim("  The work so far is kept: tell it what to do next, or say \"continue\".")
    }
}

# Fails in a row, without a change that worked, before the turn is stopped.
LOOP_LIMIT = 8

to agent_turn(user_text) {
    change TURN = TURN + 1
    # an Esc pressed before now doesn't count
    esc_pressed()
    failed_calls = []
    # read-only calls since the last change that worked
    looks = []
    fails = 0
    when conversation_tokens() > compact_limit() { compact("") }
    before = len(MESSAGES)
    change MESSAGES = push(MESSAGES, {role: "user", content: user_text})
    steps = 0
    cut_offs = 0
    gate = new_gate()
    while yes {
        steps += 1
        when steps > MAX_STEPS {
            show yellow("  Stopped after {MAX_STEPS} rounds of tools. Say \"continue\" to let it carry on.")
            give no
        }
        t0 = clock()
        r = nothing
        tools = yes
        when PLANNING { tools = read_only_specs() }
        try {
            r = nv_chat(MESSAGES, tools)
        } else problem {
            when has(problem, STOPPED) {
                show yellow("  ■ Stopped.")
                stopped_note(steps, before)
                give no
            }
            show red("  " + explain_problem(problem))
            when steps == 1 {
                # nothing happened yet: forget the message, so that the next
                # one isn't taken as carrying on with it
                change MESSAGES = slice(MESSAGES, 0, before)
                show dim("  Your message wasn't kept. Send it again, or try another model with /model.")
            } else {
                save_session()
                show dim("  The work so far is kept: say \"continue\" to carry on.")
            }
            give no
        }
        took = clock() - t0
        when not has(r, "choices") or len(r.choices) == 0 {
            show red("  The service sent back no answer: " + one_line(to_json(r), 300))
            give no
        }
        choice = r.choices[0]
        msg = choice.message
        content = arg(msg, "content", "")
        reasoning = arg(msg, "reasoning_content", arg(msg, "reasoning", ""))
        calls = calls_of(msg)
        when kind(reasoning) == "text" and trim(reasoning) != "" {
            when SETTINGS.thinking {
                show dim("  ✻ Thinking ({fixed(took, 1)} s):")
                each l in lines(trim(reasoning)) { show dim("    " + l) }
            } else {
                show dim("  ✻ Thought for {fixed(took, 1)} s")
            }
        }
        when kind(content) == "text" and trim(content) != "" {
            show ""
            when len(calls) == 0 {
                render(trim(content))
            } else {
                show dim(trim(content))
            }
        }
        reply = {role: "assistant", content: content}
        when kind(content) != "text" { reply.content = "" }
        # A reply cut off at the length limit: a tool call in it may be
        # missing its end, so drop such calls and ask for smaller pieces.
        was_cut = arg(choice, "finish_reason", "") == "length"
        # a local model is cut off when its context is full, not at max_tokens
        cut_local = provider_of(text(arg(r, "served_by", ""))) == "ollama"
        when was_cut {
            cut_offs += 1
            calls = filter(calls, c => inputs_of(c) != nothing)
            when cut_offs > 3 {
                when cut_local {
                    show yellow("  The local model keeps running out of room in its {grouped(local_context())}-token context. /local context 65536 gives it more (if this computer has the memory), /compact makes the conversation shorter, or ask for smaller steps.")
                } else {
                    show yellow("  The model's replies keep getting cut off at {SETTINGS.max_tokens} tokens. /max raises the limit; or ask for smaller steps.")
                }
                change MESSAGES = push(MESSAGES, reply)
                save_session()
                give no
            }
            when cut_local {
                show yellow("  (The local model's {grouped(local_context())}-token context filled up and the reply got cut off; asking it to carry on in smaller pieces.)")
            } else {
                show yellow("  (The reply was too long and got cut off; asking the model to carry on in smaller pieces.)")
            }
        }
        when len(calls) > 0 { reply.tool_calls = calls }
        change MESSAGES = push(MESSAGES, reply)
        when len(calls) == 0 and not was_cut {
            reasons = finish_check(gate, content)
            when len(reasons) > 0 {
                gate.checked = yes
                show dim("  ✻ Not finishing yet: " + join(map(reasons, r => r.short), "; "))
                change MESSAGES = push(MESSAGES, {role: "user", content: finish_prompt(reasons)})
                skip
            }
            save_session()
            give yes
        }
        n = 0
        stopping = no
        each call in calls {
            n += 1
            name = arg(call.function, "name", "?")
            id = arg(call, "id", "call_{steps}_{n}")
            a = inputs_of(call)
            # every tool call gets an answer, even after Esc, or the next
            # request would be refused
            when not stopping and esc_pressed() { stopping = yes }
            when stopping {
                result = "Not run: the user stopped the work (Esc)."
            } else when a == nothing {
                tool_header(name, "")
                result_line(red("the model sent inputs that aren't valid JSON"))
                result = "Error: the arguments were not valid JSON. Send them again as a JSON object."
            } else {
                same = name + " " + to_json(a)
                when has(READ_ONLY, name) and times_in(looks, same) >= 2 {
                    tool_header("Skipped", name)
                    result_line(yellow("the same look, twice already, with nothing changed since"))
                    result = "Not run: you already made this exact call twice in this request, and nothing has changed since, so its result is above. Use it, and move on to the next step."
                } else when times_in(failed_calls, same) >= 2 {
                    tool_header("Skipped", name)
                    result_line(yellow("the same call failed twice already, so it wasn't run again"))
                    result = "Not run: this exact call (same tool, same inputs) has already failed twice in this request, so it would fail again. Don't repeat it: read the file again and copy the text exactly, try a different way, or ask the user."
                } else {
                    result = run_tool(name, a)
                    when begins(result, "Error") { failed_calls = push(failed_calls, same) }
                    when has(READ_ONLY, name) { looks = push(looks, same) }
                }
            }
            when not stopping and a != nothing { gate = track_step(gate, name, a, result) }
            when not stopping {
                when begins(result, "Error") or begins(result, "Not run") {
                    fails += 1
                } else when not has(READ_ONLY, name) {
                    fails = 0
                    looks = []
                }
            }
            change MESSAGES = push(MESSAGES, {role: "tool", tool_call_id: id, name: name, content: result})
        }
        when stopping {
            show yellow("  ■ Stopped.")
            stopped_note(steps, before)
            give no
        }
        when fails >= LOOP_LIMIT {
            show yellow("  ■ Stopped: the last {fails} steps failed, with no change that worked in between, so it seems stuck.")
            show dim("  Say \"continue\" to let it try again, or tell it what to do differently (/model switches to another model).")
            save_session()
            give no
        }
        when was_cut {
            limit_words = "it reached the length limit ({SETTINGS.max_tokens} tokens)"
            when cut_local { limit_words = "your context ({local_context()} tokens) was full" }
            change MESSAGES = push(MESSAGES, {role: "user", content: "Your last reply was cut off because {limit_words}, so anything unfinished in it was lost (finished tool calls were run). Carry on from where you were. Write long files in parts: create the file with write_file holding the first part (up to about 250 lines), then add the rest with append_file, one part at a time. Keep your thinking short."})
        }
    }
}

# One request, then how long it took and how many tokens it used.
to timed_turn(user_text) {
    t0 = clock()
    before = USAGE
    agent_turn(user_text)
    took = clock() - t0
    tokens_in = USAGE.input - before.input
    tokens_out = USAGE.output - before.output
    changed = len(filter(CHECKPOINTS, c => c.turn == TURN))
    note = "✻ {fixed(took, 1)} s · {grouped(tokens_in)} tokens in, {grouped(tokens_out)} out"
    # the backups that answered, if any did
    helpers = filter(models_used_since(before), id => id != SETTINGS.model_id)
    when len(helpers) > 0 { note += " · via " + join(helpers, ", ") }
    when changed > 0 { note += " · {changed} file(s) changed (/diff, /undo)" }
    note += " · session {short_tokens(USAGE.input + USAGE.output)} (/usage)"
    show dim("  " + note)
}

# The models that answered a request since `before` (an earlier USAGE).
to models_used_since(before) {
    out = []
    each id in keys(USAGE.by_model) {
        was = 0
        when has(before.by_model, id) { was = before.by_model[id].calls }
        when USAGE.by_model[id].calls > was { out = push(out, id) }
    }
    give out
}

# ---------- plan mode ----------

PLAN_PROMPT = "Plan mode: don't change anything yet. Look at the code with the tools that read (read_file, list_files, find_files, search, web_search, fetch_url), then write a short, concrete plan for the task below: the files to change and how, in order, and how you'll check the result. End with the plan; the user will approve it before you start.\n\nThe task: "

# Looks around and plans; the user approves the plan (or changes it) before
# anything is changed.
to plan_turn(task) {
    change PLANNING = yes
    agent_turn(PLAN_PROMPT + task)
    change PLANNING = no
    while yes {
        show ""
        answer = input(brand("  Go ahead with this plan?") + dim(" (y = yes, n = no, or say what to change) ") + brand("› "))
        when answer == nothing { give nothing }
        a = lower(trim(answer))
        when a == "n" or a == "no" {
            show dim("  Plan set aside; nothing was changed.")
            give nothing
        }
        when a == "y" or a == "yes" or a == "" {
            timed_turn("The plan is approved. Carry it out now, step by step, and check the result.")
            give nothing
        }
        change PLANNING = yes
        agent_turn("Change the plan: " + trim(answer) + "\nStill don't change anything; give the new plan.")
        change PLANNING = no
    }
}

# ---------- helper agents ----------

to helper_prompt() {
    give "You are a research helper for {APP_NAME}, a coding agent. Another agent gave you a job. Use the tools that read (read_file, list_files, find_files, search, web_search, fetch_url) to do it thoroughly, then give back a clear, complete report: what you found, with file paths and line numbers where they matter, and anything uncertain. You can't change files or run commands. The working folder is {WORKDIR}."
}

to tool_task(a) {
    about = text(arg(a, "description", "a task"))
    job = text(a.prompt)
    tool_header("Task", one_line(about, 90))
    when IN_TASK {
        result_line(red("a helper can't start another helper"))
        give "Error: a helper can't start another helper; do the job yourself."
    }
    change IN_TASK = yes
    change SPIN_LABEL = "Researching"
    msgs = [{role: "system", content: helper_prompt()}, {role: "user", content: job}]
    report = nothing
    steps = 0
    while steps < 30 and report == nothing {
        steps += 1
        r = nothing
        try {
            r = nv_chat(msgs, read_only_specs())
        } else problem {
            change IN_TASK = no
            change SPIN_LABEL = "Thinking"
            fail("the helper couldn't reach the model: " + explain_problem(problem))
        }
        msg = r.choices[0].message
        calls = calls_of(msg)
        content = arg(msg, "content", "")
        when kind(content) != "text" { content = "" }
        when len(calls) == 0 {
            report = content
        } else {
            msgs = push(msgs, {role: "assistant", content: content, tool_calls: calls})
            n = 0
            each call in calls {
                n += 1
                name = arg(call.function, "name", "?")
                inputs = inputs_of(call)
                result = "Error: the arguments were not valid JSON."
                when not has(READ_ONLY, name) {
                    result = "Error: a helper can only use " + join(READ_ONLY, ", ") + "."
                } else when inputs != nothing {
                    result = run_tool(name, inputs)
                }
                msgs = push(msgs, {role: "tool", tool_call_id: arg(call, "id", "h{steps}_{n}"), name: name, content: result})
            }
        }
    }
    change IN_TASK = no
    change SPIN_LABEL = "Thinking"
    when report == nothing { report = "The helper stopped after 30 rounds without finishing its report." }
    result_line(green("Report ready") + dim(" ({steps} rounds)"))
    give report
}
