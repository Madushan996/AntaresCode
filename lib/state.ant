# Antares Code: everything the program remembers while it runs.
# Every file shares these globals; functions change them with `change`.

APP_NAME = "Antares Code"
APP_VERSION = "2.4.0"
HOME = program_folder()      # the program itself (can be shared)
WINDOWS = env("OS") == "Windows_NT"

# Your own settings, keys, sessions and memory: in .antares-code in your
# user folder, not with the program, so the program can be shared safely.
to user_data_folder() {
    h = env("USERPROFILE")
    when h == nothing or trim(h) == "" { h = env("HOME") }
    when h == nothing or trim(h) == "" { give HOME + "/data" }
    give replace(trim(h), "\\", "/") + "/.antares-code"
}
DATA_DIR = user_data_folder()
CR = char(13)               # a carriage return (Antares has no \r escape)

# settings kept between runs, in settings.json next to the program
SETTINGS = {
    model_id: "nvidia/nemotron-3-ultra-550b-a55b",
    fallbacks: [],          # up to 4 backup models, tried in order when the model is busy, rate limited or failing
    switch_after: 120,      # seconds to wait for a model before moving on to a backup (when there is one)
    mode: "yolo",           # yolo (never ask, work autonomously) | edits | ask
    thinking: no,           # show the model's reasoning
    max_tokens: 32768,      # the longest reply allowed (thinking counts too)
    temperature: 0.2,
    timeout: 300,           # seconds to wait for a reply
    compact_at: 60000,      # tokens of conversation before it is summarised
    color: yes,
    memory: yes,            # remember you and your projects between sessions
    check_updates: yes,     # say once a day if a new version is out
    local_only: no,         # use only models on this computer, with Ollama (/local on)
    local_fallback: yes,    # when every online model fails, a local Ollama model takes over (last resort)
    local_model: "",        # the local model to use ("ollama/..."); "" picks a good downloaded one by itself
}

DEFAULT_SETTINGS = SETTINGS  # kept as they are here, for /reset
KEYS = {nvidia: nothing, gemini: nothing, openrouter: nothing, groq: nothing, ollama: nothing, tavily: nothing}   # API keys, by service (and Tavily, for web search); Ollama needs none, so "ollama" just marks it as found
OLLAMA = {checked: no, installed: no, running: no, exe: nothing, version: nothing, started: no}   # Ollama on this computer, once looked for
OLLAMA_MODELS = {}          # the models downloaded with Ollama: {tools, size, context}, by model
LOCAL_AUTO = nothing        # the local model picked by itself, once looked for ("" if there is none)
WORKDIR = "."
MESSAGES = []               # the conversation, in the OpenAI chat format
TODOS = []                  # the model's task list
ALWAYS = []                 # what the user allowed for the rest of the session
USAGE = {input: 0, output: 0, calls: 0, estimated: 0, failures: 0, switches: 0, by_model: {}}   # tokens used this session, in all and by model
SESSION_STARTED = clock()   # when this session began (seconds)
ACTIVE_MODEL = nothing      # the model that answered last (the first in the chain, or a backup)
TRYING = nothing            # the model a request is being sent to now
MODEL_HEALTH = {}           # by model: {until, strikes, reason}: a model that failed rests until `until`
SKIP_ASKED = no             # Tab was pressed while waiting: move on to the next model
TEST_REPLIES = nothing      # tests only: scripted replies by model, instead of calling a service
MODEL_LIST = []             # the chat models every connected service offers, once fetched
HAS_RG = no                 # ripgrep is installed: faster search
IN_GIT = no
MAX_STEPS = 200             # tool rounds allowed in one turn
PRINT_MODE = no             # -p: answer one prompt and exit
STOPPED = "stopped with Esc"   # the problem a request fails with when you press Esc
RUN_ONLY = {}               # settings changed for this run only, with their saved values
TURN = 0                    # how many requests the user has made
CHECKPOINTS = []            # files as they were before each change: {turn, path, before}
PROCESSES = []              # programs started in the background: {id, pid, command, log}
PLANNING = no               # plan mode: look around and plan, change nothing
IN_TASK = no                # a helper agent (the task tool) is working
TERM_COLS = 0               # the terminal's width, once found
SPIN_LABEL = "Thinking"     # what the star says while waiting for a reply
REMEMBERED_AT = 0           # the request up to which this session is remembered

# Models that answered tool calls quickly and correctly when tested.
RECOMMENDED = [
    "nvidia/nemotron-3-ultra-550b-a55b",
    "nvidia/nemotron-3.5-super-vl-120b-a12b",
    "poolside/laguna-xs-2.1",
    "mistralai/mistral-large-4-1t-a52b",
    "nvidia/nemotron-3.5-lightning-30b-a3b",
    "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
]
