# Antares Code: searching the web.
#
# With a Tavily key (free for 1,000 searches a month: /setup adds one), it
# searches the whole web through Tavily, a search service made for AI agents.
# Without one, it searches the sources that let programs search them freely:
# Wikipedia, Stack Overflow and GitHub. (Search engines' own pages, such as
# DuckDuckGo's, now turn programs away.)

AGENT = {"User-Agent": "Antares-Code (https://github.com/Madushan996/AntaresCode)", Accept: "application/json"}

# The text between `start` and `until` in s, after the first `start`, or "".
to between(s, start, until) {
    at = find(s, start)
    when at < 0 { give "" }
    rest = slice(s, at + len(start))
    end = find(rest, until)
    when end < 0 { give "" }
    give slice(rest, 0, end)
}

# HTML with its tags taken out and its common entities turned back into
# characters.
to plain(html) {
    out = ""
    inside = no
    each ch in split(text(html), "") {
        when ch == "<" {
            inside = yes
        } else when ch == ">" {
            inside = no
        } else when not inside {
            out += ch
        }
    }
    each pair in [["&amp;", "&"], ["&quot;", "\""], ["&#x27;", "'"], ["&#39;", "'"], ["&lt;", "<"], ["&gt;", ">"], ["&nbsp;", " "]] {
        out = replace(out, pair[0], pair[1])
    }
    give trim(replace(out, "\n", " "))
}

HEX = "0123456789abcdef"

# A web address with its %XX escapes turned back into characters (the plain
# ones; others stay as they are, which still works as an address).
to url_decode(s) {
    out = ""
    i = 0
    while i < len(s) {
        ch = s[i]
        when ch == "%" and i + 2 < len(s) {
            hi = find(HEX, lower(s[i + 1]))
            lo = find(HEX, lower(s[i + 2]))
            when hi >= 0 and lo >= 0 and hi < 8 {
                out += char(hi * 16 + lo)
                i += 3
                skip
            }
        }
        out += ch
        i += 1
    }
    give out
}

# ---------- reading each source's answer: [{title, url, snippet, source}] ----------

to tavily_results(r) {
    out = []
    each x in arg(r, "results", []) {
        out = push(out, {title: plain(arg(x, "title", "")), url: text(arg(x, "url", "")), snippet: one_line(plain(arg(x, "content", "")), 300), source: "web"})
    }
    give out
}

to wiki_results(r) {
    out = []
    each x in arg(arg(r, "query", {}), "search", []) {
        title = text(arg(x, "title", ""))
        out = push(out, {title: title, url: "https://en.wikipedia.org/wiki/" + replace(title, " ", "_"), snippet: plain(arg(x, "snippet", "")), source: "Wikipedia"})
    }
    give out
}

to so_results(r) {
    out = []
    each x in arg(r, "items", []) {
        answered = "no accepted answer"
        when arg(x, "is_answered", no) { answered = "answered" }
        tags = join(slice(arg(x, "tags", []), 0, 4), ", ")
        out = push(out, {title: plain(arg(x, "title", "")), url: text(arg(x, "link", "")), snippet: "{arg(x, "score", 0)} votes, {answered}; tags: {tags}", source: "Stack Overflow"})
    }
    give out
}

to github_results(r) {
    out = []
    each x in arg(r, "items", []) {
        about = arg(x, "description", "")
        when about == nothing { about = "" }
        out = push(out, {title: text(arg(x, "full_name", "")), url: text(arg(x, "html_url", "")), snippet: one_line(text(about), 200) + " (★ {arg(x, "stargazers_count", 0)})", source: "GitHub"})
    }
    give out
}

# Takes results from several lists in turn: the first of each, then the
# second of each, and so on, up to `wanted`.
to take_turns(lists, wanted) {
    out = []
    i = 0
    more = yes
    while more and len(out) < wanted {
        more = no
        each l in lists {
            when i < len(l) and len(out) < wanted {
                out = push(out, l[i])
                more = yes
            }
        }
        i += 1
    }
    give out
}

# ---------- searching ----------

# A Tavily search: {answer, results}.
to tavily_search(query, wanted) {
    h = {Authorization: "Bearer " + KEYS.tavily, Accept: "application/json"}
    r = json(fetch(PROVIDERS.tavily.base + "/search", {headers: h, body: {query: query, max_results: wanted, search_depth: "basic", include_answer: yes}, timeout: 30}))
    answer = arg(r, "answer", "")
    when answer == nothing { answer = "" }
    give {answer: text(answer), results: tavily_results(r)}
}

# Wikipedia, Stack Overflow and GitHub, taking turns.
to free_search(query, wanted) {
    each_wants = max(2, floor(wanted / 2) + 1)
    lists = []
    try {
        lists = push(lists, wiki_results(json(fetch("https://en.wikipedia.org/w/api.php", {query: {action: "query", list: "search", srsearch: query, format: "json", srlimit: each_wants, utf8: 1}, headers: AGENT, timeout: 20}))))
    } else problem { nothing }
    try {
        lists = push(lists, so_results(json(fetch("https://api.stackexchange.com/2.3/search/advanced", {query: {order: "desc", sort: "relevance", q: query, site: "stackoverflow", pagesize: each_wants}, headers: AGENT, timeout: 20}))))
    } else problem { nothing }
    try {
        lists = push(lists, github_results(json(fetch("https://api.github.com/search/repositories", {query: {q: query, per_page: each_wants}, headers: AGENT, timeout: 20}))))
    } else problem { nothing }
    give take_turns(lists, wanted)
}

to tool_web_search(a) {
    query = text(a.query)
    wanted = floor(clip(arg(a, "count", 6), 1, 10))
    tool_header("Web Search", "\"" + one_line(query, 80) + "\"")
    answer = ""
    results = []
    from = ""
    note = ""
    when has_key("tavily") {
        try {
            got = tavily_search(query, wanted)
            answer = got.answer
            results = got.results
            from = "Tavily"
        } else problem {
            why = one_line(problem, 160)
            when has(problem, "error 401") or has(problem, "error 403") { why = "it didn't accept the key (/setup changes it)" }
            when has(problem, "error 429") or has(problem, "error 432") or has(problem, "error 433") { why = "the key's searches are used up for now" }
            detail(yellow("Tavily: " + why + "; searching Wikipedia, Stack Overflow and GitHub instead"))
            note = "(Tavily didn't work: " + why + ". These come from Wikipedia, Stack Overflow and GitHub only.)"
        }
    }
    when from == "" {
        results = free_search(query, wanted)
        from = "Wikipedia, Stack Overflow and GitHub"
        when note == "" { note = "(No web search key is set, so these come from Wikipedia, Stack Overflow and GitHub only; for other sites, read a page you know with fetch_url, such as the official documentation. The user can add a free Tavily key with /setup to search the whole web.)" }
    }
    when len(results) == 0 and answer == "" {
        result_line("no results" + dim(" ({from})"))
        give "No results for \"{query}\" from {from}. Try other words. {note}"
    }
    result_line("{len(results)} results" + dim(" from {from}"))
    out = []
    when answer != "" { out = push(out, "Answer from the search service: " + answer + "\n") }
    n = 0
    each r in results {
        n += 1
        label = ""
        when r.source != "web" { label = " ({r.source})" }
        detail(dim("{n}. {one_line(r.title, 90)}{label}"))
        out = push(out, "{n}. {r.title}{label}\n   {r.url}\n   {r.snippet}")
    }
    give join(out, "\n") + "\n\n(Read a page with fetch_url.) " + note
}
