# Antares Code: programs that keep running in the background (servers,
# watchers, games), started by the model and stopped when done.
#
# Each runs from a small script, with what it prints going to a log file,
# so it carries on while the conversation does. On Windows, PowerShell's
# Start-Process starts it apart from this program (and gives its process
# number, to stop it and everything it started); elsewhere, nohup does.

to process_folder() = DATA_DIR + "/.processes"

to process_by_id(n) {
    each p in PROCESSES {
        when p.id == n { give p }
    }
    give nothing
}

to process_running(p) {
    when WINDOWS {
        r = shell("tasklist /FI \"PID eq {p.pid}\" /NH", {timeout: 15})
        give has(r.output, " {p.pid} ")
    }
    give shell("kill -0 {p.pid}", {timeout: 15}).code == 0
}

# The last `count` lines a program printed.
to process_tail(p, count) {
    when not exists(p.log) { give "" }
    cmd = "tail -n {count} \"{p.log}\""
    when WINDOWS { cmd = "type \"" + native(p.log) + "\"" }
    all = lines(shell(cmd, {timeout: 15}).output)
    when len(all) > count { all = slice(all, len(all) - count) }
    give join(all, "\n")
}

to tool_start_process(a) {
    cmd = text(a.command)
    tool_header("Start", one_line(cmd, 110))
    words = split(trim(cmd))
    first_word = "command"
    when len(words) > 0 { first_word = words[0] }
    ok = permitted("command", "command:" + first_word, "run " + first_word + " commands")
    when not ok.ok { give refused(ok) }
    make_folder(process_folder())
    n = len(PROCESSES) + 1
    log = process_folder() + "/{n}.log"
    when exists(log) { delete(log) }
    pid = ""
    when WINDOWS {
        script = process_folder() + "/{n}.cmd"
        write(script, "@echo off{CR}\ncd /d \"{native(WORKDIR)}\"{CR}\n{cmd}{CR}\n")
        launcher = process_folder() + "/{n}.ps1"
        # cmd /c drops the outermost quotes of what follows, so there is an extra pair
        write(launcher, "$p = Start-Process -FilePath 'cmd.exe' -ArgumentList '/c \"\"{native(script)}\" > \"{native(log)}\" 2>&1\"' -WindowStyle Hidden -PassThru\n$p.Id\n")
        r = shell("powershell -NoProfile -ExecutionPolicy Bypass -File \"" + native(launcher) + "\"", {timeout: 30})
        pid = trim(r.output)
    } else {
        script = process_folder() + "/{n}.sh"
        write(script, "cd \"{WORKDIR}\"\n{cmd}\n")
        r = shell("nohup sh \"{script}\" > \"{log}\" 2>&1 & echo $!", {timeout: 30})
        pid = trim(r.output)
    }
    when number_or_nothing(pid) == nothing { fail("it didn't start: " + one_line(r.output + " " + r.errors, 200)) }
    p = {id: n, pid: number(pid), command: cmd, log: log}
    change PROCESSES = push(PROCESSES, p)
    # a moment to start, so the first output is there to see
    wait(1.5)
    early = process_tail(p, 12)
    running = process_running(p)
    when running { result_line(green("Running as process {n}")) } else { result_line(yellow("Process {n} ended at once")) }
    when early != "" { preview(early, 6) }
    state = "is running"
    when not running { state = "has already ended" }
    give "Started process {n}; it {state}. Its first output:\n{squeeze(early, 4000)}\n(process_output with id {n} shows more; stop_process with id {n} stops it.)"
}

to tool_process_output(a) {
    n = floor(arg(a, "id", 0))
    count = floor(arg(a, "lines", 60))
    tool_header("Output", "process {n}")
    p = process_by_id(n)
    when p == nothing { fail("there is no process {n}") }
    out = process_tail(p, count)
    running = process_running(p)
    state = "running"
    when not running { state = "ended" }
    result_line("{len(lines(out))} lines" + dim(" · {state}"))
    give squeeze(out, 20000) + "\n[process {n} has {state}]"
}

to stop_process(p) {
    when WINDOWS {
        shell("taskkill /T /F /PID {p.pid}", {timeout: 30})
    } else {
        shell("pkill -P {p.pid}; kill {p.pid}", {timeout: 30})
    }
}

to tool_stop_process(a) {
    n = floor(arg(a, "id", 0))
    tool_header("Stop", "process {n}")
    p = process_by_id(n)
    when p == nothing { fail("there is no process {n}") }
    stop_process(p)
    result_line(green("Stopped process {n}"))
    give "Stopped process {n}."
}

# When Antares Code ends, so do the programs it started.
to stop_all_processes() {
    each p in PROCESSES {
        when process_running(p) { stop_process(p) }
    }
}

to show_processes() {
    when len(PROCESSES) == 0 {
        show dim("  No programs were started in the background.")
        give nothing
    }
    show ""
    each p in PROCESSES {
        state = red("ended")
        when process_running(p) { state = green("running") }
        show "  " + brand(pad(p.id, 3)) + state + "  " + one_line(p.command, 90)
    }
    show dim("  /stop <number> stops one.")
    show ""
}
