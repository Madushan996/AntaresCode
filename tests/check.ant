# Checks Antares Code's tools without calling the model service.
#   antares tests/check.ant

use "../lib/state"
use "../lib/guide"
use "../lib/ui"
use "../lib/api"
use "../lib/tools"
use "../lib/web"
use "../lib/processes"
use "../lib/history"
use "../lib/memory"
use "../lib/setup"
use "../lib/update"
use "../lib/agent"
use "../lib/commands"

s = SETTINGS
s.color = no
s.mode = "yolo"
SETTINGS = s
# the tests keep their own settings folder, away from yours
DATA_DIR = replace(HOME, "\\", "/") + "/data"

# a scratch project to work in, outside this repository (so its .gitignore
# doesn't hide the project from the search tools)
tmp = env("TEMP")
when tmp == nothing or trim(tmp) == "" { tmp = "/tmp" }
base = replace(tmp, "\\", "/") + "/antares-code-check"
when exists(base) {
    when WINDOWS { shell("rmdir /s /q \"" + native(base) + "\"") } else { shell("rm -rf \"" + base + "\"") }
}
make_folder(base + "/src/util")
WORKDIR = base
write(base + "/src/main.py", "def add(a, b):\n    return a + b\n\nprint(add(2, 3))\n")
write(base + "/src/util/helpers.js", "export const twice = n => n * 2\n")
write(base + "/README.md", "# Scratch\n")
write(base + "/notes.txt", "line one{CR}\nline two{CR}\n")
detect = shell("rg --version").code == 0
HAS_RG = detect

# glob matching
check(glob_match("*.py", "src/main.py"), "*.py matches by name")
check(glob_match("src/**/*.js", "src/util/helpers.js"), "** crosses folders")
check(glob_match("**/*.md", "README.md"), "**/ matches at the top too")
check(not glob_match("src/*.js", "src/util/helpers.js"), "* doesn't cross folders")
check(glob_match("*.\{js,py}", "src/main.py") and glob_match("*.\{js,py}", "a/b.js"), "braces")
check(glob_match("ma?n.py", "main.py"), "?")

# paths
check(full_path("src/main.py") == base + "/src/main.py", "relative paths")
check(full_path("./src") == base + "/src", "./ paths")
check(full_path("C:/x/y") == "C:/x/y" and full_path("/x") == "/x", "absolute paths")
check(rel(base + "/src/main.py") == "src/main.py", "rel")
check(parent_of(base + "/a/b.txt") == base + "/a", "parent_of")

# reading
r = run_tool("read_file", {path: "src/main.py"})
check(has(r, "     1  def add(a, b):") and has(r, "     4  print(add(2, 3))"), "read_file numbers lines: {r}")
r = run_tool("read_file", {path: "src/main.py", offset: 2, limit: 1})
check(has(r, "     2      return a + b") and not has(r, "def add") and has(r, "offset 3"), "read_file with offset and limit")
check(begins(run_tool("read_file", {path: "nope.py"}), "Error: there is no file"), "read_file of a missing file")

# editing
r = run_tool("edit_file", {path: "src/main.py", old_string: "return a + b", new_string: "return a + b  # sum"})
check(has(read(base + "/src/main.py"), "return a + b  # sum"), "edit_file: {r}")
check(has(run_tool("edit_file", {path: "src/main.py", old_string: "not there", new_string: "x"}), "was not found"), "edit_file reports missing text")
write(base + "/twice.txt", "a\na\n")
check(has(run_tool("edit_file", {path: "twice.txt", old_string: "a", new_string: "b"}), "appears 2 times"), "edit_file reports repeats")
run_tool("edit_file", {path: "twice.txt", old_string: "a", new_string: "b", replace_all: yes})
check(read(base + "/twice.txt") == "b\nb\n", "edit_file replace_all")
run_tool("edit_file", {path: "notes.txt", old_string: "line one\nline two", new_string: "first\nsecond"})
check(read(base + "/notes.txt") == "first{CR}\nsecond{CR}\n", "edit_file keeps Windows line endings")

# edits with the wrong indentation (as the model copied it, 6 spaces for 4)
write(base + "/todo.py", "def show():\n    for i in items:\n        print(i)\n\nif x:\n    show()\n")
r = run_tool("edit_file", {path: "todo.py", old_string: "def show():\n      for i in items:\n          print(i)\n", new_string: "def show():\n      for i in items:\n          print(i)\n\ndef done(n):\n    items[n] = 1\n"})
check(read(base + "/todo.py") == "def show():\n    for i in items:\n        print(i)\n\ndef done(n):\n    items[n] = 1\n\nif x:\n    show()\n", "edit_file matches ignoring indentation, and re-indents: {r}")
check(has(r, "indentation"), "edit_file says it matched loosely")
write(base + "/twice2.py", "if a:\n    go()\nif b:\n    go()\n")
check(has(run_tool("edit_file", {path: "twice2.py", old_string: "      go()", new_string: "stop()"}), "2 times when indentation is ignored"), "a loose match in two places is refused")
write(base + "/crlf.py", "def f():{CR}\n    return 1{CR}\n")
run_tool("edit_file", {path: "crlf.py", old_string: "def f():\n  return 1", new_string: "def f():\n  return 2"})
check(read(base + "/crlf.py") == "def f():{CR}\n    return 2{CR}\n", "a loose match keeps Windows line endings")
write(base + "/multi.py", "def a():\n    x = 1\n    y = 2\n")
r = run_tool("multi_edit", {path: "multi.py", edits: [{old_string: "      x = 1", new_string: "      x = 10"}, {old_string: "    y = 2", new_string: "    y = 20"}]})
check(read(base + "/multi.py") == "def a():\n    x = 10\n    y = 20\n", "multi_edit matches ignoring indentation: {r}")
check(has(run_tool("edit_file", {path: "multi.py", old_string: "z = 3", new_string: "z = 4"}), "was not found"), "text that isn't there at all is still not found")

# writing, into a new folder
run_tool("write_file", {path: "deep/new/file.txt", content: "hello\n"})
check(read(base + "/deep/new/file.txt") == "hello\n", "write_file makes folders")

# listing, finding, searching
r = run_tool("list_files", {})
check(has(r, "src/") and has(r, "README.md"), "list_files: {r}")
r = run_tool("find_files", {pattern: "**/*.js"})
check(has(r, "src/util/helpers.js") and not has(r, "main.py"), "find_files: {r}")
r = run_tool("search", {pattern: "twice", glob: "*.js"})
check(has(r, "helpers.js") and has(r, "twice"), "search: {r}")
HAS_RG = no
r = run_tool("search", {pattern: "add\\(", ignore_case: yes})
check(has(r, "main.py"), "search without ripgrep: {r}")
r = run_tool("find_files", {pattern: "*.py"})
check(has(r, "src/main.py"), "find_files without ripgrep: {r}")
check(run_tool("search", {pattern: "zzz_nothing_zzz"}) == "No matches.", "search with no matches")
HAS_RG = detect

# commands
r = run_tool("run_command", {command: "echo hi"})
check(has(r, "hi") and has(r, "[exit code 0]"), "run_command: {r}")
check(has(run_tool("run_command", {command: "exit 3"}), "[exit code 3]"), "run_command exit codes")

# asking first, with no one to answer
s = SETTINGS
s.mode = "ask"
SETTINGS = s
PRINT_MODE = yes
check(has(run_tool("run_command", {command: "echo no"}), "needs the user's permission"), "commands ask first")
check(has(run_tool("write_file", {path: "x.txt", content: "x"}), "needs the user's permission") and not exists(base + "/x.txt"), "writes ask first")
s.mode = "edits"
SETTINGS = s
run_tool("write_file", {path: "x.txt", content: "x"})
check(exists(base + "/x.txt"), "edits mode writes without asking")
check(has(run_tool("run_command", {command: "echo no"}), "needs the user's permission"), "edits mode still asks for commands")

# several edits at once: all or nothing
s = SETTINGS
s.mode = "yolo"
SETTINGS = s
PRINT_MODE = no
TURN = 1
CHECKPOINTS = []
write(base + "/multi.txt", "alpha\nbeta\ngamma\n")
r = run_tool("multi_edit", {path: "multi.txt", edits: [{old_string: "alpha", new_string: "ALPHA"}, {old_string: "gamma", new_string: "GAMMA"}]})
check(read(base + "/multi.txt") == "ALPHA\nbeta\nGAMMA\n", "multi_edit: {r}")
r = run_tool("multi_edit", {path: "multi.txt", edits: [{old_string: "beta", new_string: "B"}, {old_string: "nope", new_string: "x"}]})
check(has(r, "edit 2") and read(base + "/multi.txt") == "ALPHA\nbeta\nGAMMA\n", "multi_edit changes nothing when one fails: {r}")
r = run_tool("multi_edit", {path: "multi.txt", edits: "[\{\"old_string\": \"beta\", \"new_string\": \"BETA\"}]"})
check(read(base + "/multi.txt") == "ALPHA\nBETA\nGAMMA\n", "multi_edit takes edits sent as JSON text: {r}")
run_tool("edit_file", {path: "multi.txt", old_string: "BETA", new_string: "beta"})

# moving, deleting, and taking it all back
TURN = 2
run_tool("move_file", {from_path: "multi.txt", to_path: "moved/multi.txt"})
check(not exists(base + "/multi.txt") and exists(base + "/moved/multi.txt"), "move_file")
check(has(run_tool("move_file", {from_path: "README.md", to_path: "moved/multi.txt"}), "already exists"), "move_file won't overwrite")
run_tool("delete_file", {path: "README.md"})
check(not exists(base + "/README.md"), "delete_file")
run_tool("write_file", {path: "brand_new.txt", content: "new\n"})
d = changes()
check(len(d) == 4, "changes: {map(d, c => rel(c.path))}")
done = undo_last()
check(exists(base + "/README.md") and exists(base + "/multi.txt") and not exists(base + "/moved/multi.txt") and not exists(base + "/brand_new.txt"), "undo puts back request 2: {done}")
check(read(base + "/multi.txt") == "ALPHA\nbeta\nGAMMA\n", "undo keeps request 1's edits")
undo_last()
check(read(base + "/multi.txt") == "alpha\nbeta\ngamma\n", "undo again goes back to before request 1")
check(len(undo_last()) == 0, "nothing more to undo")
check(line_count_diff(["a", "b", "b"], ["b"]) == 2, "line_count_diff")

# web search results, from saved answers
t = tavily_results(json("\{\"answer\":\"x\",\"results\":[\{\"title\":\"Serde &amp; JSON\",\"url\":\"https://serde.rs\",\"content\":\"A fast library\"}]}"))
check(len(t) == 1 and t[0].title == "Serde & JSON" and t[0].url == "https://serde.rs" and t[0].snippet == "A fast library", "tavily_results: {t}")
w = wiki_results(json("\{\"query\":\{\"search\":[\{\"title\":\"Rust (programming language)\",\"snippet\":\"a <span class=\\\"searchmatch\\\">borrow</span> checker\"}]}}"))
check(w[0].url == "https://en.wikipedia.org/wiki/Rust_(programming_language)" and w[0].snippet == "a borrow checker" and w[0].source == "Wikipedia", "wiki_results: {w}")
so = so_results(json("\{\"items\":[\{\"title\":\"How do I read a &quot;JSON&quot; file?\",\"link\":\"https://stackoverflow.com/q/1\",\"score\":42,\"is_answered\":true,\"tags\":[\"python\",\"json\"]}]}"))
check(so[0].title == "How do I read a \"JSON\" file?" and has(so[0].snippet, "42 votes, answered") and has(so[0].snippet, "python, json"), "so_results: {so}")
g = github_results(json("\{\"items\":[\{\"full_name\":\"a/b\",\"html_url\":\"https://github.com/a/b\",\"description\":null,\"stargazers_count\":7}]}"))
check(g[0].title == "a/b" and has(g[0].snippet, "★ 7"), "github_results: {g}")
check(take_turns([[1, 2, 3], [10], [20, 21]], 5) == [1, 10, 20, 2, 21], "take_turns")
check(url_decode("a%20b%2Fc") == "a b/c", "url_decode")
check(times_in(["a", "b", "a"], "a") == 2, "times_in")
check(PROVIDERS.tavily.name == "Tavily" and not has(PROVIDER_ORDER, "tavily"), "Tavily is a key, not a model service")

# programs in the background
r = run_tool("start_process", {command: "echo started && ping -n 30 127.0.0.1 > nul"})
when not WINDOWS { r = run_tool("start_process", {command: "echo started; sleep 30"}) }
check(has(r, "Started process") and has(r, "is running"), "start_process: {r}")
n = PROCESSES[len(PROCESSES) - 1].id
check(has(run_tool("process_output", {id: n}), "started"), "process_output")
run_tool("stop_process", {id: n})
check(not process_running(process_by_id(n)), "stop_process")
check(has(run_tool("process_output", {id: 99}), "no process 99"), "unknown processes")

# notes and custom commands
WORKDIR = base
where = add_note("Run the tests with: antares tests/check.ant")
check(where == "ANTARES.md" and has(read(base + "/ANTARES.md"), "- Run the tests with"), "add_note")
check(project_memory().name == "ANTARES.md", "notes are read from ANTARES.md")
make_folder(base + "/.antares-code/commands")
write(base + "/.antares-code/commands/hello.md", "# Say hello\nSay hello to $ARGUMENTS.\n")
c = custom_commands()
check(len(filter(c, x => x.name == "hello" and x.about == "Say hello")) == 1, "custom commands: {c}")
check(has(map(read_only_specs(), t => t.function.name), "web_search") and not has(map(read_only_specs(), t => t.function.name), "write_file"), "read-only tools")

# memory about the user and projects (kept in tests/memory while testing)
when exists(memory_folder()) {
    when WINDOWS { shell("rmdir /s /q \"" + native(memory_folder()) + "\"") } else { shell("rm -rf \"" + memory_folder() + "\"") }
}
check(add_user_note("Prefers short answers"), "add_user_note")
check(not add_user_note("prefers short answers"), "the same fact isn't added twice")
add_user_note("Writes games in Antares")
check(len(note_lines(you_file())) == 2 and has(user_memory(), "Writes games in Antares"), "user_memory: {user_memory()}")
check(has(run_tool("remember", {note: "Likes dark themes", about: "you"}), "every project"), "remember about you")
check(forget("dark themes") == 1 and len(note_lines(you_file())) == 2, "forget")
note_project("Added a scoreboard")
WORKDIR = base + "/src"
note_project("Fixed the parser")
check(has(other_projects(), "Added a scoreboard") and not has(other_projects(), "Fixed the parser"), "other_projects leaves out this one: {other_projects()}")
WORKDIR = base
check(begins(note_lines(projects_file())[0], "- " + base + "/src ·") and len(note_lines(projects_file())) == 2, "the latest project comes first")
repeat 7 as i { note_recent_work("Step {i}") }
recent = filter(lines(read(base + "/ANTARES.md")), l => has(l, ": Step"))
check(len(recent) == 5 and has(recent[4], "Step 7") and has(read(base + "/ANTARES.md"), "- Run the tests with"), "recent work keeps the latest 5 and the notes: {recent}")
MESSAGES = [{role: "user", content: "Make the snake faster"}, {role: "assistant", content: "Done: speed is now 12."}, {role: "user", content: "Plan mode: ..."}]
d = session_digest()
check(len(d.asked) == 1 and len(d.answers) == 1, "session_digest: {d}")
check(has(system_prompt(), "Writes games in Antares"), "what is known about the user goes into the instructions")
when WINDOWS { shell("rmdir /s /q \"" + native(memory_folder()) + "\"") } else { shell("rm -rf \"" + memory_folder() + "\"") }

# starting again: keys and settings go; with all, memory and conversations too
make_folder(DATA_DIR + "/sessions")
write(DATA_DIR + "/sessions/x.json", "\{}")
save_key("gemini", "AIza-reset-test-000000")
s = SETTINGS
s.mode = "ask"
SETTINGS = s
save_settings()
add_user_note("Likes tea")
gone = reset_data(no)
check(not exists(keys_file()) and not exists(DATA_DIR + "/settings.json") and KEYS.gemini == nothing, "reset removes keys and settings: {gone}")
check(SETTINGS.mode == DEFAULT_SETTINGS.mode and exists(DATA_DIR + "/sessions/x.json") and len(note_lines(you_file())) == 1, "reset keeps conversations and memory")
reset_data(yes)
check(not exists(DATA_DIR + "/sessions") and not exists(memory_folder()), "reset all removes conversations and memory")
s = SETTINGS
s.color = no
SETTINGS = s

# the same model on two services
check(base_model("nvidia/nemotron-3-ultra-550b-a55b:free") == "nvidia/nemotron-3-ultra-550b-a55b" and base_model("gemini-3.8-flash") == "gemini-3.8-flash", "base_model")
check(provider_of("nvidia/nemotron-3-ultra-550b-a55b") == "nvidia" and provider_of("nvidia/nemotron-3-ultra-550b-a55b:free") == "openrouter", "the service is told apart by :free, not by the maker")
check(place_in(["a", "b"], "b") == 1 and place_in(["a"], "z") == -1, "place_in")
saved_keys = KEYS
KEYS = {nvidia: "nvapi-test", gemini: nothing, openrouter: "sk-or-test", tavily: nothing}
check(same_model_elsewhere("nvidia/nemotron-3-ultra-550b-a55b:free", []) == "nvidia/nemotron-3-ultra-550b-a55b", "an OpenRouter model's NVIDIA twin")
check(same_model_elsewhere("nvidia/nemotron-3-ultra-550b-a55b", ["nvidia/nemotron-3-ultra-550b-a55b:free"]) == "nvidia/nemotron-3-ultra-550b-a55b:free", "an NVIDIA model's OpenRouter twin")
check(same_model_elsewhere("cohere/north-mini-code:free", []) == nothing, "no twin")
# step 2 of the welcome screen: OpenRouter was set up before, NVIDIA is connected now
lists = [{p: "openrouter", ids: ["cohere/north-mini-code:free", "nvidia/nemotron-3-ultra-550b-a55b:free"]}, {p: "nvidia", ids: ["nvidia/nemotron-3-ultra-550b-a55b", "poolside/laguna-xs-2.1"]}]
c = model_choices(lists, ["nvidia"], "cohere/north-mini-code:free")
check(c.groups[0].p == "nvidia" and c.first == 0 and c.options[c.first] == "nvidia/nemotron-3-ultra-550b-a55b", "a service connected just now comes first, and Enter picks its model: {c.options}")
check(has(c.options, "cohere/north-mini-code:free") and c.groups[1].p == "openrouter", "the other service's models are still offered")
c = model_choices(lists, [], "cohere/north-mini-code:free")
check(c.options[c.first] == "cohere/north-mini-code:free", "with nothing new connected, Enter keeps the model in use")
c = model_choices(lists, [], "poolside/laguna-xs-2.1")
check(c.options[c.first] == "poolside/laguna-xs-2.1" and c.groups[0].p == "openrouter", "keeping the model in use, wherever it is listed")
KEYS = saved_keys

# new versions
check(is_newer("v2.1.0", "2.0.0") and is_newer("2.10.0", "2.9.9") and is_newer("v3", "2.9") and not is_newer("v2.1.0", "2.1.0") and not is_newer("2.0.9", "2.1"), "comparing versions")
check(version_numbers("v2.10.1") == [2, 10, 1], "version_numbers")

# the welcome box fits the terminal, shortening long parts in the middle
row = [["folder  ", "dim"], ["C:/Users/someone/Documents/Projects/very/long/path/to/project", ""]]
f = fit_row(row, 30)
check(len(row_text(f)) == 30 and has(row_text(f), "…") and begins(row_text(f), "folder  C:/") and ends(row_text(f), "project"), "fit_row: {row_text(f)}")
check(row_text(fit_row(row, 200)) == row_text(row), "short rows are left alone")

# todos, unknown tools, and tool inputs
check(has(run_tool("todo_write", {todos: [{content: "a", status: "completed"}, {content: "b", status: "in_progress"}]}), "updated"), "todo_write")
check(len(TODOS) == 2, "todos kept")
check(has(run_tool("dance", {}), "no tool called dance"), "unknown tools")
check(inputs_of({function: {name: "x", arguments: "\{\"a\": 1}"}}).a == 1, "inputs from JSON text")
check(inputs_of({function: {name: "x", arguments: ""}}) == {}, "empty inputs")
check(inputs_of({function: {name: "x", arguments: "\{oops"}}) == nothing, "bad inputs")
check(chat_model("nvidia/nemotron-3-ultra-550b-a55b") and not chat_model("nvidia/nv-embedqa-mistral-7b-v2"), "chat models")

# two services: which one a model belongs to, keys, and the best models
check(provider_of("nvidia/nemotron-3-ultra-550b-a55b") == "nvidia" and provider_of("mistralai/mistral-large-4-1t-a52b") == "nvidia", "NVIDIA models have a slash")
check(provider_of("gemini-3.8-flash") == "gemini" and provider_of("gemma-3-27b-it") == "gemini", "Gemini models don't")
check(chat_model("gemini-3.8-flash") and not chat_model("gemini-embedding-001") and not chat_model("imagen-4.0-generate") and not chat_model("gemini-2.5-flash-preview-tts"), "Gemini chat models")
check(recommended("gemini-3.8-flash") and recommended("gemini-3.8-pro") and not recommended("gemini-3.8-flash-lite") and not recommended("gemini-3.9-pro-preview"), "recommended Gemini models")
check(default_model("gemini", ["gemini-2.5-flash", "gemini-3.8-flash", "gemini-3.8-pro", "gemini-3.8-flash-lite"]) == "gemini-3.8-flash", "the newest plain Flash first")
check(default_model("nvidia", ["a/b", "nvidia/nemotron-3.5-super-vl-120b-a12b"]) == "nvidia/nemotron-3.5-super-vl-120b-a12b", "a recommended NVIDIA model")
check(masked("nvapi-abcdefghijklmnop1234") == "nvapi-…1234" and masked(nothing) == "not set", "keys are shown masked")
make_folder(DATA_DIR)
save_key("gemini", "AIza-test-key-123456")
check(KEYS.gemini == "AIza-test-key-123456" and load(keys_file()).gemini == "AIza-test-key-123456", "save_key")
KEYS = {nvidia: nothing, gemini: nothing, openrouter: nothing}
load_keys()
check(KEYS.gemini == "AIza-test-key-123456", "load_keys reads the keys file")
check(has(explain_problem("error 400 from Gemini: API key not valid. Please pass a valid API key."), "didn't accept the API key"), "a bad Gemini key is explained")
check(provider_of("nvidia/nemotron-3-ultra-550b-a55b:free") == "openrouter" and provider_of("cohere/north-mini-code:free") == "openrouter", "OpenRouter's free models end in :free")
or_ids = ["cohere/north-mini-code:free", "google/gemma-4-31b-it:free", "liquid/lfm-3-1.7b:free", "nvidia/nemotron-3-ultra-550b-a55b:free"]
check(suggested_models("openrouter", or_ids) == ["nvidia/nemotron-3-ultra-550b-a55b:free", "cohere/north-mini-code:free"], "OpenRouter suggestions: {suggested_models("openrouter", or_ids)}")
check(suggested_models("gemini", ["gemini-2.5-flash", "gemini-3.8-flash", "gemini-3.8-pro", "gemini-3.8-flash-lite"]) == ["gemini-3.8-flash", "gemini-3.8-pro"], "Gemini suggestions")
check(suggested_models("gemini", ["gemini-2.5-pro", "gemini-3.1-pro-preview", "gemini-3.7-flash", "gemini-3.8-flash", "gemini-omni-1.2-flash", "gemini-pro-latest"]) == ["gemini-3.8-flash", "gemini-pro-latest"], "Gemini suggestions skip previews and odd models")
check(recommended("nvidia/nemotron-3-ultra-550b-a55b:free") and not recommended("liquid/lfm-3-1.7b:free"), "recommended OpenRouter models")
check(squeeze("abcdefghij", 4) == "ab\n... [6 characters cut] ...\nij", "squeeze")

# ---------- backup models, and failures told apart ----------
check(status_of("error 429 from OpenRouter: x") == 429 and status_of("https://x answered with error 503: busy") == 503 and status_of("no error here") == 0, "status_of")
check(retry_hint("error 429 from NVIDIA (retry-after 12 s): x") == 12, "retry_hint: Retry-After")
check(retry_hint("\{\"retryDelay\": \"37s\"}") == 37, "retry_hint: Gemini's retryDelay")
reset_ms = floor((clock() + 50) * 1000)
hint = retry_hint("\{\"X-RateLimit-Reset\":\"{reset_ms}\"}")
check(hint != nothing and hint > 45 and hint <= 51, "retry_hint: OpenRouter's reset time: {hint}")
check(retry_hint("nothing to see") == nothing, "retry_hint: none")
check(failure_of("error 429 from NVIDIA: too many", 0).kind == "limit" and failure_of("error 429 from NVIDIA: too many", 0).rest == 10, "429 is a rate limit")
check(failure_of("error 429 from NVIDIA: too many", 2).rest == 40, "rests grow with each failure")
check(failure_of("error 429 from NVIDIA (retry-after 33 s): x", 0).rest == 33, "the service's wait is used")
check(failure_of("error 429 from OpenRouter: Rate limit exceeded: free-models-per-day", 0).rest == 3600, "a daily limit rests for long")
check(failure_of("the request timed out after 120 s", 0).kind == "timeout", "timeouts")
check(failure_of("error 503 from Gemini: overloaded", 0).kind == "busy", "busy")
check(failure_of("error 401 from NVIDIA: no", 0).final and failure_of("error 404 from NVIDIA: gone", 0).final, "bad keys and missing models are final")
check(failure_of("error 400 from Gemini: context length exceeded", 0).reason == "the conversation is too long for it", "too long")
check(failure_of("bad reply from NVIDIA: it was empty", 0).reason == "an empty reply", "empty replies")
check(failure_of(STOPPED, 0).kind == "stopped", "Esc")
good = to_json({choices: [{message: {role: "assistant", content: "hi"}, finish_reason: "stop"}], usage: {prompt_tokens: 100, completion_tokens: 20}})
check(reply_fault(json(good)) == nothing, "a good reply")
check(reply_fault({choices: [{message: {role: "assistant", content: ""}, finish_reason: "stop"}]}) == "it was empty", "an empty reply")
check(reply_fault({choices: [{message: {role: "assistant", content: "", tool_calls: [{id: "1", function: {name: "x", arguments: "\{}"}}]}}]}) == nothing, "tool calls alone are fine")
check(has(reply_fault({error: {code: 429, message: "slow down"}}), "error 429"), "an error inside a 200 reply")
check(reply_fault({choices: []}) == "it held no answer", "no choices")
check(grouped(152340) == "152,340" and grouped(999) == "999" and grouped(1000000) == "1,000,000", "grouped")
check(short_tokens(980) == "980" and short_tokens(45230) == "45.2k" and short_tokens(1250000) == "1.25M", "short_tokens")

KEYS = {nvidia: "nvapi-test", gemini: "AIza-test", openrouter: "sk-or-test", tavily: nothing}
s = SETTINGS
s.model_id = "nvidia/main-model"
s.fallbacks = ["gemini-3.8-flash", "nvidia/main-model", "x/y:free", "a/b", "c/d", "e/f"]
SETTINGS = s
check(model_chain() == ["nvidia/main-model", "gemini-3.8-flash", "x/y:free", "a/b", "c/d"], "the chain: no repeats, at most 5: {model_chain()}")
s.fallbacks = ["gemini-3.8-flash", "x/y:free"]
SETTINGS = s
MODEL_HEALTH = {}
USAGE = {input: 0, output: 0, calls: 0, estimated: 0, failures: 0, switches: 0, by_model: {}}

# rate limited: the backup answers at once, and the main model rests
TEST_REPLIES = {"nvidia/main-model": ["FAIL error 429 from NVIDIA: Too Many Requests"], "gemini-3.8-flash": [good]}
r = nv_chat([{role: "user", content: "hi"}], no)
check(r.served_by == "gemini-3.8-flash" and ACTIVE_MODEL == "gemini-3.8-flash", "a rate limited model hands over to the next")
check(rest_left("nvidia/main-model") > 5 and health_of("nvidia/main-model").reason == "rate limited", "the rate limited model rests")
check(USAGE.calls == 1 and USAGE.input == 100 and USAGE.output == 20 and USAGE.failures == 1 and USAGE.switches == 1, "usage counts the answer and the failure: {USAGE}")
check(USAGE.by_model["gemini-3.8-flash"].calls == 1 and USAGE.by_model["nvidia/main-model"].failures == 1, "usage by model")

# while it rests, requests go straight to the backup
TEST_REPLIES = {"gemini-3.8-flash": [good]}
r = nv_chat([{role: "user", content: "hi"}], no)
check(r.served_by == "gemini-3.8-flash", "a resting model is passed over")

# once rested, the main model is first again
forgive("nvidia/main-model")
TEST_REPLIES = {"nvidia/main-model": [good]}
r = nv_chat([{role: "user", content: "hi"}], no)
check(r.served_by == "nvidia/main-model" and ACTIVE_MODEL == "nvidia/main-model", "back to the main model after its rest")

# broken and empty replies, and timeouts, hand over too
TEST_REPLIES = {"nvidia/main-model": ["the service is down"], "gemini-3.8-flash": [to_json({choices: [{message: {role: "assistant", content: ""}, finish_reason: "stop"}]})], "x/y:free": ["FAIL the request timed out after 120 s"]}
MODEL_HEALTH = {}
failed_all = ""
# (no waiting for a model to rest, in the tests)
MAX_PAUSE = 0
try { nv_chat([{role: "user", content: "hi"}], no) } else problem { failed_all = problem }
MAX_PAUSE = 90
check(explain_problem(failed_all) == failed_all and has(failed_all, "Every model failed") and has(failed_all, "a broken reply") and has(failed_all, "an empty reply") and has(failed_all, "too slow"), "when every model fails, each is named: {failed_all}")

# a reply without token counts is estimated
MODEL_HEALTH = {}
before_est = USAGE.estimated
TEST_REPLIES = {"nvidia/main-model": [to_json({choices: [{message: {role: "assistant", content: "hello there"}, finish_reason: "stop"}]})]}
nv_chat([{role: "user", content: "hi"}], no)
check(USAGE.estimated == before_est + 1 and USAGE.by_model["nvidia/main-model"].estimated == 1, "missing token counts are estimated")

# a model without a key is left out of the chain
KEYS = {nvidia: "nvapi-test", gemini: nothing, openrouter: "sk-or-test", tavily: nothing}
MODEL_HEALTH = {}
TEST_REPLIES = {"nvidia/main-model": ["FAIL error 503 from NVIDIA: overloaded"], "x/y:free": [good]}
r = nv_chat([{role: "user", content: "hi"}], no)
check(r.served_by == "x/y:free", "a backup with no key is skipped")

# one model alone: a final problem fails at once, as it is
s.fallbacks = []
SETTINGS = s
MODEL_HEALTH = {}
TEST_REPLIES = {"nvidia/main-model": ["FAIL error 401 from NVIDIA: Unauthorized"]}
alone = ""
try { nv_chat([{role: "user", content: "hi"}], no) } else problem { alone = problem }
check(has(alone, "error 401"), "one model: a bad key fails at once: {alone}")
# and a busy one is waited for and tried again
MODEL_HEALTH = {}
TEST_REPLIES = {"nvidia/main-model": ["FAIL error 429 from NVIDIA (retry-after 1 s): busy", good]}
r = nv_chat([{role: "user", content: "hi"}], no)
check(r.served_by == "nvidia/main-model", "one model: tried again after its wait")
TEST_REPLIES = nothing
MODEL_HEALTH = {}
ACTIVE_MODEL = nothing

# ---------- tool-call JSON as models really send it ----------
q = char(34)
bs = char(92)
to tool_call(args) = {function: {name: "x", arguments: args}}
check(inputs_of(tool_call("```json\n\{" + q + "path" + q + ": " + q + "a.py" + q + "}\n```")) == {path: "a.py"}, "JSON in a code fence")
check(inputs_of(tool_call("Here you go: \{" + q + "path" + q + ": " + q + "a.py" + q + "} hope that helps")) == {path: "a.py"}, "words around the JSON")
check(inputs_of(tool_call("\{'path': 'it" + bs + "'s " + q + "here" + q + ".py'}")) == {path: "it's " + q + "here" + q + ".py"}, "single-quoted strings")
check(inputs_of(tool_call("\{" + q + "all" + q + ": True, " + q + "x" + q + ": None, " + q + "n" + q + ": 1e3}")) == {all: yes, x: nothing, n: 1000}, "True, None and numbers")
check(inputs_of(tool_call("\{" + q + "s" + q + ": " + q + bs + "u00e9t" + bs + "u00e9 " + bs + "u2192 " + bs + "ud83d" + bs + "ude00" + q + "}")).s == "été → 😀", "\\u escapes become their characters: {inputs_of(tool_call("\{" + q + "s" + q + ": " + q + bs + "u00e9" + q + "}"))}")
check(inputs_of(tool_call("\{" + q + "s" + q + ": " + q + bs + "u0022" + bs + "u005c" + q + "}")).s == q + bs, "escaped quotes and backslashes stay escaped")
check(inputs_of(tool_call("\{" + q + "path" + q + ": " + q + "C:" + bs + "Users" + bs + "me" + bs + "d.txt" + q + "}")).path == "C:" + bs + "Users" + bs + "me" + bs + "d.txt", "backslashes of unknown escapes are kept: {inputs_of(tool_call("\{" + q + "path" + q + ": " + q + "C:" + bs + "Users" + q + "}"))}")
check(inputs_of(tool_call("\{" + q + "s" + q + ": " + q + "a" + bs + "nb" + bs + "t" + bs + q + "c" + bs + bs + q + "}")).s == "a\nb\t" + q + "c" + bs, "valid escapes mean the same")
check(inputs_of(tool_call("\{" + q + "s" + q + ": " + q + "line one\nline two" + q + "}")).s == "line one\nline two", "raw newlines in strings")
check(inputs_of(tool_call("\{" + q + "a" + q + ": [1, \{" + q + "b" + q + ": " + q + "}]" + q + "}], " + q + "c" + q + ": 2}")) == {a: [1, {b: "}]"}], c: 2}, "brackets inside strings don't end the object")
check(inputs_of(tool_call("\{" + q + "path" + q + ": " + q + "a.py" + q + ", " + q + "content" + q + ": " + q + "print(1")) == nothing, "cut-off JSON is still refused")
check(repair_json("no json here") == nothing, "no object at all")

# ---------- the check before finishing ----------
g = new_gate()
check(finish_check(g, "Here is how it works.") == [], "nothing to check after a plain answer")
g = track_step(g, "read_file", {path: "a.py"}, "1 x")
check(finish_check(g, "Done.") == [], "reading isn't changing")
g = track_step(g, "edit_file", {path: "src/a.py"}, "Updated src/a.py")
g = track_step(g, "edit_file", {path: "README.md"}, "Updated README.md")
check(g.unchecked == ["src/a.py"] and len(finish_check(g, "Done.")) == 1 and has(finish_check(g, "Done.")[0].short, "src/a.py changed, not run since"), "code changed and not run: {finish_check(g, "Done.")}")
g2 = track_step(g, "run_command", {command: "python -m unittest"}, "OK\n[exit code 0]")
check(finish_check(g2, "Done.") == [], "running it clears the check")
g3 = track_step(g, "run_command", {command: "python -m unittest"}, "FAILED\n[exit code 1]")
check(has(finish_check(g3, "Done.")[0].long, "exited with code 1"), "a failed run is named")
g4 = track_step(g3, "edit_file", {path: "src/a.py"}, "Updated src/a.py")
check(g4.failed == "" and len(g4.unchecked) == 1, "a change after a failure: the failure is over, but it isn't run yet")
check(finish_check(track_step(g, "run_command", {command: "x"}, "The user said no."), "Done.") == [], "after the user says no, nothing is checked")
g5 = g
g5.checked = yes
check(finish_check(g5, "Done.") == [], "only once a request")
check(promises_more("I found the bug. Now I'll run the tests.") and promises_more("Let me check the config.") and not promises_more("Let me know if you want more.") and not promises_more("Should I run it?") and not promises_more("All tests pass."), "promising more work")
check(len(finish_check(new_gate(), "Next, I'll update the parser.")) == 1, "a promise alone is checked")
check(exit_code_in("x\n[exit code 2]") == 2 and exit_code_in("none") == nothing, "exit_code_in")

# a whole request: the model writes code and tries to finish without running it
s = SETTINGS
s.model_id = "nvidia/main-model"
s.fallbacks = []
SETTINGS = s
KEYS = {nvidia: "nvapi-test", gemini: nothing, openrouter: nothing, tavily: nothing}
to scripted_call(name, args) = to_json({choices: [{message: {role: "assistant", content: "", tool_calls: [{id: "c_" + name, type: "function", function: {name: name, arguments: to_json(args)}}]}, finish_reason: "tool_calls"}], usage: {prompt_tokens: 10, completion_tokens: 5}})
to scripted_text(t) = to_json({choices: [{message: {role: "assistant", content: t}, finish_reason: "stop"}], usage: {prompt_tokens: 10, completion_tokens: 5}})
start_conversation()
TEST_REPLIES = {"nvidia/main-model": [scripted_call("write_file", {path: "gate_demo.py", content: "print(6 * 7)\n"}), scripted_text("Done: gate_demo.py prints 42."), scripted_call("run_command", {command: "python gate_demo.py"}), scripted_text("It prints 42.")]}
check(agent_turn("make gate_demo.py print 42") == yes, "the request finishes")
nudges = filter(MESSAGES, m => m.role == "user" and kind(m.content) == "text" and begins(m.content, FINISH_NOTE))
check(len(nudges) == 1 and has(nudges[0].content, "gate_demo.py"), "the model was sent back once, naming the file: {len(nudges)}")
check(len(TEST_REPLIES["nvidia/main-model"]) == 0, "it carried on and ran the file")
# when it ran what it changed, it isn't sent back
start_conversation()
TEST_REPLIES = {"nvidia/main-model": [scripted_call("write_file", {path: "gate_demo.py", content: "print(1)\n"}), scripted_call("run_command", {command: "python gate_demo.py"}), scripted_text("Prints 1.")]}
agent_turn("make it print 1")
check(len(filter(MESSAGES, m => m.role == "user" and begins(text(m.content), FINISH_NOTE))) == 0, "no check when the change was run")
# and it is sent back only once, even if it still won't run anything
start_conversation()
TEST_REPLIES = {"nvidia/main-model": [scripted_call("write_file", {path: "gate_demo.py", content: "print(2)\n"}), scripted_text("Done."), scripted_text("There is nothing to run here.")]}
check(agent_turn("make it print 2") == yes and len(filter(MESSAGES, m => m.role == "user" and begins(text(m.content), FINISH_NOTE))) == 1, "only one check a request")
TEST_REPLIES = nothing
start_conversation()

# a command stopped by its time limit says so
slow = "sleep 5"
when WINDOWS { slow = "ping -n 6 127.0.0.1" }
r = run_tool("run_command", {command: slow, timeout: 1})
check(has(r, "stopped after 1 s") and has(r, "start_process"), "a timed-out command says so: {one_line(r, 200)}")
check(not has(run_tool("run_command", {command: "echo quick"}), "stopped after"), "a quick command doesn't")

when WINDOWS { shell("rmdir /s /q \"" + native(base) + "\"") } else { shell("rm -rf \"" + base + "\"") }
when WINDOWS { shell("rmdir /s /q \"" + native(DATA_DIR) + "\"") } else { shell("rm -rf \"" + DATA_DIR + "\"") }
show "Antares Code tools: all checks passed"
